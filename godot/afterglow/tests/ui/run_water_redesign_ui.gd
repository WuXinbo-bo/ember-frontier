extends "res://tests/ui/run_service_access_ui.gd"
const WaterPanel = preload("res://scripts/ui/factory_water.gd")

func press(key: String) -> bool:
	var control := keyed(key)
	check("real water button available " + key, control is Button and not control.disabled, control.tooltip_text if control != null else "missing")
	if not control is Button or control.disabled: return false
	control.pressed.emit(); await flush(); return true

func run() -> void:
	var args := OS.get_cmdline_user_args(); output = args[0]; DirAccess.make_dir_recursive_absolute(output)
	root.size = Vector2i(1280,800); host = TestClient.new(); root.add_child(host)
	var original := FileAccess.get_file_as_string(args[1])
	var decoded := Store.decode(original)
	check("E actual paid five-second repair checkpoint decodes read-only", decoded.get("ok",false))
	if not decoded.get("ok",false) or not await mount_capture(decoded.capture): return finish()
	var water: Dictionary = runtime.factory_snapshot().get("water",{})
	var sources: Array = F.dictionaries(water.get("sources",[]))
	check("same owner publishes actual discovered water source", water.get("available",false) and sources.size()==1)
	if sources.is_empty(): return finish()
	var id := str(sources[0].id)
	ui.open_panel("water",id); await flush()
	var original_state: Dictionary = runtime.capture_checkpoint()
	var current := WaterPanel.project(ui,id)
	check("real active repair state and elapsed labor shown", current.get("operation")=="repair" and float(current.get("progress_seconds",0))>0 and text_in(ui._body).contains("实际有效劳动"))
	check("water route fixes actual source identity",ui.world_view_selection()=={"kind":"water","id":id})
	check("opening water page does not charge again",Data.json_equal(original_state,runtime.capture_checkpoint()))
	var before_seconds: float = float(current.get("progress_seconds",0))
	for i in 10: runtime.tick(0.1)
	ui.refresh(); await flush()
	check("modal pauses unique water owner labor",WaterPanel.project(ui,id).get("progress_seconds")==before_seconds and runtime.is_paused())
	await press("water:command:held:"+id)
	check("pause work retains route and same project",not ui.pages.is_empty() and WaterPanel.project(ui,id).get("id")==current.id and runtime.actor("player").intent.held==false)
	await press("water:command:held:"+id)
	check("resume closes page and releases unique clock",ui.pages.is_empty() and runtime.actor("player").intent.held==true and not runtime.is_paused())
	for i in 3: runtime.tick(0.1)
	ui.refresh(); await flush()
	check("actual world alone advances water labor",float(WaterPanel.work(ui).get("elapsed",0))>before_seconds)
	ui.open_panel("water",id); await flush()
	var material_before: Array = runtime.capture_checkpoint().facts.stocks.duplicate(true)
	await press("water:command:cancel:"+id)
	check("cancel clears actual intent without spending uncompleted materials",runtime.actor("player").get("intent")==null and Data.json_equal(material_before,runtime.capture_checkpoint().facts.stocks))
	check("cancel keeps real finite 48 and no minted water",F.find(F.dictionaries(runtime.factory_snapshot().water.sources),id).remaining==48)
	ui.open_panel("water",id); await flush()
	var repair := keyed("water:command:repair:"+id) as Button
	check("same physical supplies allow real retry after cancellation",repair != null and not repair.disabled)
	if repair != null and not repair.disabled:
		repair.pressed.emit(); await flush()
		check("retry begins original modules labor",ui.pages.is_empty() and runtime.actor("player").get("intent",{}).get("owner")=="modules")
		for i in 170: runtime.tick(0.1)
		ui.refresh(); await flush()
		ui.open_panel("water",id); await flush()
		check("completed actual repair changes UI to draw",keyed("water:command:draw:"+id)!=null and keyed("water:command:repair:"+id)==null)
		await press("water:command:draw:"+id)
		for i in 125: runtime.tick(0.1)
		ui.refresh(); await flush()
		ui.open_panel("water",id); await flush()
		check("real draw reduces finite balance exactly once",F.find(F.dictionaries(runtime.factory_snapshot().water.sources),id).remaining==47)
	ui.close_panels(); await flush()
	var refused: Dictionary = ui.execute("module.water.draw","missing-water",{"output_id":"pack:player"},true)
	check("missing source rejects visibly without private substitute",not refused.get("ok",false) and not ui._notice.text.is_empty())
	check("E original checkpoint bytes remain unchanged",FileAccess.get_file_as_string(args[1])==original)
	finish()
