extends SceneTree
const Assembly=preload("res://scripts/runtime/factory_assembly.gd")
const Factory=preload("res://scripts/world/factory_generator.gd")
const Modules=preload("res://scripts/modules/module_service.gd")
const Native=preload("res://scripts/runtime/native_client.gd")
const Router=preload("res://scripts/input/input_router.gd")
var checks:Array=[]
func _initialize()->void:call_deferred("run")
func check(label:String,ok:bool)->void:
	checks.append({"name":label,"ok":ok})
	if not ok:print("FAIL "+label)
func run()->void:
	var output:String=OS.get_cmdline_user_args()[0];DirAccess.make_dir_recursive_absolute(output)
	var prepared:Dictionary=Assembly.prepare(Assembly.generate(713,Modules.generation_profiles()))
	check("actual factory source builds",prepared.get("ok",false))
	if not prepared.get("ok",false):return finish(output)
	var host:=Native.new();var built:Dictionary=host._assemble(prepared.capture);host.free()
	check("formal runtime assembles",built.get("ok",false))
	if not built.get("ok",false):return finish(output)
	var runtime:RefCounted=built.runtime;var router:=Router.new()
	router.controls_path=output+"/controls.json";root.add_child(router);router.configure(runtime)
	router._pressed={"up":true,"run":true};router._primary=true
	router.set_modal_policy(true,false)
	check("live map blocks world inputs and releases held movement",router.is_paused() and router._pressed.is_empty() and not router.state().held.primary)
	check("live map does not pause the one simulation",not router.world_is_paused() and not runtime.is_paused())
	var before:float=runtime.clock();runtime.tick(0.1)
	check("NPC and production continue on sole clock with map open",is_equal_approx(runtime.clock()-before,0.1))
	router.set_window_focus(false);before=runtime.clock();runtime.tick(5.0)
	check("focus loss still pauses live map without accumulating time",router.world_is_paused() and runtime.clock()==before)
	router.set_window_focus(true)
	check("focus return preserves live modal and requires fresh input",router.is_paused() and not runtime.is_paused() and router._pressed.is_empty())
	router.set_file_dialog(true)
	check("file dialog independently pauses live map",runtime.is_paused())
	router.set_file_dialog(false);router.set_modal(true)
	check("confirmation or inventory inherits ordinary paused policy",router.is_paused() and runtime.is_paused() and router.state().modal_pauses_world)
	router.set_modal_policy(true,false);router.set_streaming(true);router.set_modal_policy(false,false)
	check("closing map cannot clear real streaming barrier",router.is_paused() and runtime.is_paused())
	router.set_streaming(false)
	check("all reasons clear without stale run or primary",not router.is_paused() and not runtime.is_paused() and router._pressed.is_empty() and not router.state().held.primary)
	router.free();finish(output)
func finish(output:String)->void:
	var report:Dictionary={"scope":"actual source runtime and input policy, not GUI/OS/final package acceptance","checks":checks,"failed":checks.filter(func(c:Dictionary)->bool:return not c.ok).size()}
	FileAccess.open(output+"/results.json",FileAccess.WRITE).store_string(JSON.stringify(report,"\t",true,true))
	print(JSON.stringify({"checks":checks.size(),"failed":report.failed}));quit(1 if report.failed else 0)
