extends "res://tests/buildings/domain_suite.gd"
## Actual imported actor surfaces, native depth-overlay lifecycle only.
const Actors=preload("res://scripts/presentation/actor_view.gd")
const Occlusion=preload("res://scripts/presentation/player_occlusion.gd")
const Data=preload("res://scripts/world/world_data.gd")

func run()->void:
	var started:int=Time.get_ticks_msec()
	expect("finite authority fixture loads",world.load_snapshot(Generator.generate(713)).ok)
	initialize_at({"x":30,"y":0,"z":43,"regionId":"RH-HOME","buildingId":null,"storeyId":null})
	var before:Dictionary=runtime.capture_checkpoint()
	var stage:=Node3D.new();root.add_child(stage)
	var actors:=Actors.new();stage.add_child(actors);actors.configure(runtime);actors.set_process(false)
	var other_actors:=Actors.new();stage.add_child(other_actors);other_actors.configure(runtime);other_actors.set_process(false)
	var target:Vector3=actors.roots.player.global_position+Vector3(0,1.1,0)
	var camera:=Camera3D.new();stage.add_child(camera);camera.projection=Camera3D.PROJECTION_ORTHOGONAL;camera.size=24
	camera.position=target+Vector3(0,0,10);camera.look_at(target)
	var blockers:=Node3D.new();stage.add_child(blockers)
	var cube:=BoxMesh.new();cube.size=Vector3(3,3,0.5)
	var obstacle:=MeshInstance3D.new();obstacle.mesh=cube;obstacle.position=target+Vector3(0,0,2);blockers.add_child(obstacle)
	var next_blockers:=Node3D.new();stage.add_child(next_blockers)
	var occlusion:=Occlusion.new();stage.add_child(occlusion);occlusion.configure(camera,actors,blockers);occlusion.set_process(false);occlusion._process(0.2)
	var meshes:Array=actors.roots.player.find_children("*","MeshInstance3D",true,false)
	expect("actual original meshes are occluded before rebinding",actors._player_occluded and meshes.all(func(m:MeshInstance3D)->bool:return m.material_overlay!=null))
	occlusion.configure(camera,other_actors,next_blockers)
	expect("rebind immediately restores prior actor surface overlays",not actors._player_occluded and meshes.all(func(m:MeshInstance3D)->bool:return m.material_overlay==null))
	expect("rebind retires prior blocked state and geometry subscriptions",not occlusion.statistics().player_occluded and occlusion._watched.is_empty() and occlusion._triangles.is_empty())
	occlusion._process(0.2)
	expect("new view with empty building root inherits no occlusion",not other_actors._player_occluded and not occlusion.statistics().player_occluded)
	var next_obstacle:=MeshInstance3D.new();next_obstacle.mesh=cube;next_obstacle.position=obstacle.position;next_blockers.add_child(next_obstacle);occlusion._process(0.2)
	expect("new actual geometry still activates derived overlay",other_actors._player_occluded)
	occlusion.free()
	expect("retired occlusion component restores live actor original materials",not other_actors._player_occluded and other_actors.roots.player.find_children("*","MeshInstance3D",true,false).all(func(m:MeshInstance3D)->bool:return m.material_overlay==null))
	expect("all occlusion lifecycle reads preserve sole authority",Data.json_equal(before,runtime.capture_checkpoint()))
	stage.free()
	print("DDD_OCCLUSION_LIFECYCLE "+JSON.stringify({"scope":"actual actor/material/native geometry fixtures; no normal-camera pixels or VA","checks":checks,"failures":failures,"elapsed_ms":Time.get_ticks_msec()-started}))
	quit(0 if failures.is_empty() else 1)
